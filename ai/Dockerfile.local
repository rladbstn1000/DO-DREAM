FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 LANGCHAIN_TRACING_V2=false
COPY requirements.local.lock.txt ./
RUN pip install --no-cache-dir -r requirements.local.lock.txt
COPY app ./app
COPY tests ./tests
RUN mkdir -p /app/db_data/local_provider
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
