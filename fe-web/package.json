{
  "name": "fe-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:local": "vite --config vite.config.ts --mode phase1 --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test:auth": "node --experimental-strip-types --test tests/auth-session.test.ts tests/native-contract.test.ts",
    "test:browser-auth": "node tests/browser-auth.mjs",
    "test:authorization": "node --experimental-strip-types --test tests/authorization-contract.test.ts",
    "test:browser-authorization": "node tests/browser-authorization.mjs",
    "test:grading": "node --experimental-strip-types --test tests/grading-submission.test.ts",
    "test:browser-grading": "node tests/browser-grading.mjs",
    "test:indexing": "node --experimental-strip-types --test tests/indexing-status.test.ts",
    "test:browser-indexing": "node tests/browser-indexing.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.7.2",
    "@tiptap/extension-highlight": "^3.7.2",
    "@tiptap/extension-horizontal-rule": "^3.7.2",
    "@tiptap/extension-image": "^3.7.2",
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-subscript": "^3.7.2",
    "@tiptap/extension-superscript": "^3.7.2",
    "@tiptap/extension-table": "^3.7.2",
    "@tiptap/extension-table-cell": "^3.7.2",
    "@tiptap/extension-table-header": "^3.7.2",
    "@tiptap/extension-table-row": "^3.7.2",
    "@tiptap/extension-text-align": "^3.7.2",
    "@tiptap/extension-underline": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "docx": "^9.5.1",
    "lottie-web": "^5.13.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "sweetalert2": "^11.26.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
